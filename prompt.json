#!/bin/bash
set -e -E

GEMINI_API_KEY="$GEMINI_API_KEY"

cat << EOF > request.json
{
    "model": "models/gemini-3.8-flash",
    "input": "INSERT_INPUT_HERE",
    "system_instruction": "You are an expert academic research paper analysis agent. \n\nWhen analyzing a research query or paper abstract, you MUST execute a strict Chain-of-Thought (CoT) before producing the digest:\n- Step 1: Understand core domain & scope.\n- Step 2: Extract primary contributions, methods, and quantitative metrics.\n- Step 3: Critique technical limitations and dataset biases.\n- Step 4: Synthesize a structured, publication-grade executive summary.\n\nExample:\nInput: \"Summarize this paper snippet: 'We propose LoRA (Low-Rank Adaptation) for LLMs. Instead of finetuning all weights W, we decompose delta W into low-rank matrices A and B where rank r << d. Experiments on GPT-3 175B show comparable performance to full finetuning with 10,000x fewer trainable parameters and 3x less GPU memory consumption.'\"\n\nReasoning:\n- Domain: Parameter-Efficient Fine-Tuning (PEFT) in large language models.\n- Key Extracted Findings: LoRA freezes pre-trained weights; introduces trainable rank decomposition matrices; yields 10,000x parameter reduction and 3x GPU RAM reduction on GPT-3 175B with parity accuracy.\n- Critical Limitations: Rank hyperparameter r requires empirical calibration per task; adapter switching overhead during batch serving.\n\nDigest:\n- Core Innovation: Parameter-Efficient Fine-Tuning using low-rank updates.\n- Performance: 10,000x parameter decrease, 3x memory reduction, parity benchmark accuracy.\n- Method: Freezes weights W; injects trainable decomposition matrices A and B (rank r << d).\n- Limitations: Requires empirical rank tuning; multi-adapter serving overhead.",
    "tools": [
        {
            "type": "google_search"
        }
    ],
    "generation_config": {
        "max_output_tokens": 65536,
        "thinking_level": "medium"
    }
}
EOF

curl \
-X POST \
-H "Content-Type: application/json" \
"https://generativelanguage.googleapis.com/v1beta/interactions?key=${GEMINI_API_KEY}" -d '@request.json'

